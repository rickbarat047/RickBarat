rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isValidUser(data, userId) {
      return data.uid == userId &&
             data.email is string &&
             data.email.size() >= 3 && data.email.size() <= 120 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('bookmarkedProjectIds' in data) || (data.bookmarkedProjectIds is list && data.bookmarkedProjectIds.size() <= 30)) &&
             (!('starredLabIds' in data) || (data.starredLabIds is list && data.starredLabIds.size() <= 30));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidUser(incoming(), userId);
      allow delete: if isOwner(userId);

      match /chatHistory/{messageId} {
        allow read, write: if isOwner(userId);
      }
    }

    function isValidGuestbook(data) {
      return data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.role in ['Recruiter', 'Client', 'Engineer', 'Collaborator', 'Visitor'] &&
             data.message is string && data.message.size() >= 2 && data.message.size() <= 600 &&
             (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 120)) &&
             (!('authorPhoto' in data) || (data.authorPhoto is string && data.authorPhoto.size() <= 500));
    }

    match /guestbook/{entryId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(entryId) && isValidGuestbook(incoming());
      allow update: if isSignedIn() && existing().authorId == request.auth.uid && isValidGuestbook(incoming());
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }

    function isValidInquiry(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.message is string && data.message.size() >= 2 && data.message.size() <= 2000 &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 200)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow get, list: if false;
      allow update, delete: if false;
    }
  }
}
